# kordinate — customer operations console (kore product).
PORT=8080
BASE_URL=https://kordinate.example.com
DB_HOST=mariadb
DB_PORT=3306
DB_USER=kordinate
DB_PASS=change-me
DB_NAME=kordinate
ENCRYPTION_KEY=          # openssl rand -base64 32
SESSION_KEY=             # openssl rand -base64 32

# SSO via kontrol (control-plane IdP).
AUTH_MODE=kontrol
OIDC_ISSUER_URL=https://kontrol.example.com
OIDC_CLIENT_ID=kordinate
OIDC_CLIENT_SECRET=
OAUTH_REDIRECT_URL=https://kordinate.example.com/auth/callback

# Licence (Ed25519).
LICENCE_PUBLIC_KEY=
LICENCE_FILE=/app/kordinate.licence

# AI provider — drives document vetting (vision). Settings-driven at runtime
# too; these are the boot fallback. One of anthropic|openai.
# AI_PROVIDER=anthropic
# AI_API_KEY=

# ---------------------------------------------------------------------------
# Upstream MamaMoney microservices.
#
# UPSTREAM_MODE=fake (the default) serves a deterministic in-memory dataset so
# kordinate runs locally with no VPN and no credentials. Set it to "live" to
# talk to the real services — anything other than "live" fails safe to fake.
# Names match claire-admin's so existing deployment config carries over.
# ---------------------------------------------------------------------------
UPSTREAM_MODE=fake

CUSTOMER_SERVICE_URL=
CLAIRE_API_URL=
CLAIRE_API_FILE_URL=
UML_URL=
UOPS_API_URL=
EMMA_API=
IDV_SERVICE_API_URL=
DEVICE_BLOCKER_SERVICE_URL=
VMS_API_URL=

# Claire uses OAuth1-style consumer credentials.
CLAIRE_OAUTH_CONSUMER_KEY=
CLAIRE_OAUTH_CONSUMER_SECRET=
CLAIRE_OAUTH_TOKEN=
CLAIRE_OAUTH_TOKEN_SECRET=
